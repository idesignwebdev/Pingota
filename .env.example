# Copy to .env for a local run. On Dokploy set these in the project UI.
# Nothing secret is committed; both generated values below must be unique.

# --- Required ---------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Encrypts router passwords, payment keys and install tokens.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Site -------------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# https://pingota.yourdomain.example
DJANGO_CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://localhost:8000
TIME_ZONE=Africa/Nairobi

# --- Database ---------------------------------------------------------------
# Compose default points at the bundled mongo service.
# Atlas or external cluster: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://mongo:27017
MONGODB_NAME=pingota
# Optional Postgres instead of Mongo (needs psycopg installed):
DATABASE_URL=

# --- Router onboarding ------------------------------------------------------
# TunGuard runs on the Docker host. Open UDP 13231 publicly for router peers.
# Public DNS name for this VPS; it must resolve from the MikroTik router.
ROUTER_TUNNEL_HOST=
ROUTER_TUNNEL_PORT=13231
ROUTER_TUNNEL_SUBNET=10.70.0.0/16
# TunGuard API URL from the web container and an API key with peer write access.
TUNGARD_API_URL=http://host.docker.internal:9000
TUNGARD_API_KEY=

# --- First account ----------------------------------------------------------
# Created once at boot. This is the platform owner (approves ISP signups).
ADMIN_USERNAME=owner@example.com
ADMIN_PASSWORD=change-me-before-deploy

# --- Runtime ----------------------------------------------------------------
SCHEDULER_ENABLED=true
RUN_SCHEDULER=true
WEB_CONCURRENCY=2
WEB_THREADS=4
SEED_DEMO=false
LOG_LEVEL=INFO

# --- Payments ---------------------------------------------------------------
# Optional platform-wide Paystack key. Each ISP sets their own in the panel and
# theirs takes precedence; leave empty to require every ISP to bring a key.
PAYSTACK_SECRET_KEY=
# Webhook signing secret (whsec_...) for the platform account. Each ISP can
# store their own under Settings. Without it, only the legacy signature works.
PAYSTACK_WEBHOOK_SECRET=
MPESA_ENV=production
